{
  "name": "rehab-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.14.1 <25.0.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "2.2.0",
      "brace-expansion@1.1.16": "1.1.18",
      "brace-expansion@2.1.2": "2.1.4",
      "brace-expansion@5.0.7": "5.0.9",
      "fast-uri@3.1.4": "3.1.5",
      "js-yaml@^3.13.1": "3.15.1",
      "nanoid@3.3.12": "3.3.18",
      "nanoid@3.3.16": "3.3.18",
      "postcss@8.5.14": "8.5.26",
      "postcss@8.5.23": "8.5.26"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @rehab-platform/api --filter @rehab-platform/web dev",
    "dev:web": "pnpm --filter @rehab-platform/web dev",
    "dev:api": "pnpm --filter @rehab-platform/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "check:static": "node scripts/run-full-regression.mjs --scope static",
    "test:unit": "node scripts/run-full-regression.mjs --scope unit",
    "test:postgres": "node scripts/run-full-regression.mjs --scope postgres",
    "regression:full": "node scripts/run-full-regression.mjs --scope full",
    "db:generate": "pnpm --filter @rehab-platform/db prisma:generate",
    "db:migrate": "pnpm --filter @rehab-platform/db prisma:migrate",
    "db:migration:manifest:verify": "node scripts/verify-prisma-migration-manifest.mjs",
    "db:migrate:deploy": "pnpm db:migration:manifest:verify && pnpm --filter @rehab-platform/db prisma:migrate:deploy",
    "db:migrate:status": "pnpm db:migration:manifest:verify && pnpm --filter @rehab-platform/db prisma:migrate:status",
    "db:sensitive:backfill": "pnpm --filter @rehab-platform/db sensitive:backfill",
    "db:bootstrap:production": "pnpm --filter @rehab-platform/db bootstrap:production",
    "db:seed": "pnpm --filter @rehab-platform/db prisma:seed",
    "db:seed:trial": "pnpm --filter @rehab-platform/db prisma:seed:trial",
    "verify:render-blueprint": "node scripts/verify-render-blueprint.mjs",
    "verify:mimo:connectivity": "node --env-file=.env scripts/check-mimo-connectivity.mjs",
    "supply-chain:artifacts": "node scripts/produce-production-supply-chain.mjs",
    "verify:supply-chain:production": "node scripts/verify-production-supply-chain.mjs",
    "verify:api-sast": "node scripts/run-api-sast.mjs",
    "delivery:check": "node scripts/check-delivery-readiness.mjs",
    "delivery:check:production": "node scripts/check-delivery-readiness.mjs --production-env",
    "test:delivery": "node --test scripts/__tests__/*.test.mjs",
    "test:playwright": "node scripts/run-playwright-regression.mjs",
    "verify:contracts": "node scripts/verify-local-contracts.mjs",
    "verify:trial-empty-loop": "node scripts/verify-trial-empty-loop.mjs",
    "verify:empty-real-loop": "node scripts/verify-empty-real-loop-orchestrator.mjs",
    "verify:formal-acceptance-chain": "node scripts/verify-formal-acceptance-chain.mjs",
    "verify:multi-condition-data-capture": "node scripts/verify-multi-condition-data-capture.mjs",
    "verify:ad8-caregiver-interview-acceptance": "node scripts/verify-ad8-caregiver-interview-acceptance.mjs",
    "verify:customer-production-input": "node scripts/verify-customer-production-input.mjs",
    "verify:customer-acceptance-package-manifest": "node scripts/verify-customer-acceptance-package-manifest.mjs",
    "verify:browser-pose-evidence": "node scripts/verify-browser-pose-evidence.mjs",
    "verify:browser-pose-field-acceptance": "node scripts/verify-browser-pose-field-acceptance.mjs",
    "verify:unity-field-evidence": "node scripts/verify-unity-field-evidence.mjs",
    "verify:unity-field-acceptance": "node scripts/verify-unity-field-acceptance.mjs",
    "verify:speech-transcript-evidence": "node scripts/verify-speech-transcript-evidence.mjs",
    "verify:speech-transcript-acceptance": "node scripts/verify-speech-transcript-acceptance.mjs",
    "verify:ai-assessment-acceptance": "node scripts/verify-ai-assessment-acceptance.mjs",
    "verify:speech-ai-assessment-acceptance": "node scripts/verify-speech-ai-assessment-acceptance.mjs",
    "verify:tts-speech-output-evidence": "node scripts/verify-tts-speech-output-evidence.mjs",
    "verify:tts-speech-output-acceptance": "node scripts/verify-tts-speech-output-acceptance.mjs",
    "verify:unity-rhythm-reach-source": "node scripts/verify-unity-rhythm-reach-source.mjs",
    "verify:unity-rhythm-reach-webgl-build": "node scripts/verify-unity-rhythm-reach-webgl-build.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "js-yaml": "4.3.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
