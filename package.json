{
  "name": "rehab-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm --parallel --filter @rehab-platform/api --filter @rehab-platform/web dev",
    "dev:web": "pnpm --filter @rehab-platform/web dev",
    "dev:api": "pnpm --filter @rehab-platform/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @rehab-platform/db prisma:generate",
    "db:migrate": "pnpm --filter @rehab-platform/db prisma:migrate",
    "db:seed": "pnpm --filter @rehab-platform/db prisma:seed",
    "db:seed:trial": "pnpm --filter @rehab-platform/db prisma:seed:trial",
    "delivery:check": "node scripts/check-delivery-readiness.mjs",
    "delivery:check:production": "node scripts/check-delivery-readiness.mjs --production-env",
    "test:delivery": "node --test scripts/__tests__/*.test.mjs",
    "verify:contracts": "node scripts/verify-local-contracts.mjs",
    "verify:trial-empty-loop": "node scripts/verify-trial-empty-loop.mjs",
    "verify:customer-production-input": "node scripts/verify-customer-production-input.mjs",
    "verify:browser-pose-evidence": "node scripts/verify-browser-pose-evidence.mjs",
    "verify:browser-pose-field-acceptance": "node scripts/verify-browser-pose-field-acceptance.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
