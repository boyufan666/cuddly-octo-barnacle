[Unit]
Description=Rehabilitation provider telemetry retention
After=rehab-api.service

[Service]
Type=oneshot
User=rehab
Group=rehab
WorkingDirectory=/opt/rehab/current/apps/api
EnvironmentFile=/etc/rehab/api.env
ExecStart=/usr/local/bin/node dist/provider-telemetry-retention.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
