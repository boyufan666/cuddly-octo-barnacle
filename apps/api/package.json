{
  "name": "@rehab-platform/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm --filter @rehab-platform/db build && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "pnpm --filter @rehab-platform/db build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "test:integration:mimo-usage-gate-redis": "node ./test/run-mimo-usage-gate-redis-integration.mjs",
    "test:e2e:continuous-conversation-high-cost-route": "node ./test/run-continuous-conversation-high-cost-route-e2e.mjs",
    "test:contracts": "node --test test/*.test.mjs",
    "telemetry:retention": "NODE_ENV=production node dist/provider-telemetry-retention.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:postgres-smoke": "node ./test/run-api-smoke-postgres-e2e.mjs",
    "test:controller-integration": "jest --config ./test/jest-controller-integration.json --runInBand",
    "test:e2e:credential-security": "node ./test/run-credential-security-postgres-e2e.mjs",
    "test:e2e:encrypted-seed-api": "node ./test/run-encrypted-seed-api-postgres-e2e.mjs",
    "test:e2e:task4": "node ./test/run-task4-postgres-concurrency.mjs",
    "test:e2e:task7": "node ./test/run-task7-postgres-lifecycle.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.2",
    "@rehab-platform/db": "workspace:*",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
