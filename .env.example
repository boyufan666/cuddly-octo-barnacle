# Local development example. Copy to .env and fill with your own values.
# Trial/production environments must use independently generated secrets and managed credentials.
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?schema=public"
POSTGRES_PASSWORD="<postgres-container-password>"
JWT_SECRET="<generate-a-long-random-secret>"
COOKIE_SECURE="<true-or-false>"
WEB_ORIGIN="http://localhost:3000"
PORT="4000"
PUBLIC_CREDENTIAL_THROTTLE_LIMIT="<positive-safe-integer>"
PUBLIC_CREDENTIAL_THROTTLE_TTL_MS="<positive-safe-integer-milliseconds>"
DEFAULT_PATIENT_PASSWORD="<local-initial-password>"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# Disposable browser regression only. The runner rejects any database name other
# than rehab_playwright_test and resets the whole database before every run.
PLAYWRIGHT_DATABASE_URL="postgresql://<test_user>:<test_password>@127.0.0.1:<test_port>/rehab_playwright_test"
PLAYWRIGHT_CONFIRM_DISPOSABLE="YES"
PLAYWRIGHT_WEB_PORT="<unused-web-port>"
PLAYWRIGHT_API_PORT="<different-unused-api-port>"
PLAYWRIGHT_JWT_SECRET="<test-jwt-secret-at-least-32-bytes>"
PLAYWRIGHT_COOKIE_SECURE="false"
PLAYWRIGHT_PUBLIC_CREDENTIAL_THROTTLE_LIMIT="<positive-safe-integer>"
PLAYWRIGHT_PUBLIC_CREDENTIAL_THROTTLE_TTL_MS="<positive-safe-integer-milliseconds>"
PLAYWRIGHT_SENSITIVE_DATA_KEY_REF="<test-sensitive-key-reference>"
PLAYWRIGHT_SENSITIVE_DATA_KEY="<test-32-byte-key-as-canonical-base64>"
PLAYWRIGHT_SEED_PASSWORD="<policy-valid-initial-seed-password>"
PLAYWRIGHT_ACCOUNT_PASSWORD="<different-policy-valid-browser-test-password>"

# Sensitive field encryption, pnpm db:seed, and pnpm db:seed:trial require
# the same exact key id and 32-byte key used by the API runtime.
SENSITIVE_DATA_KEY_REF="<secret-manager-reference-for-sensitive-data-key>"
# Local development only: canonical base64 for exactly 32 random bytes.
# Production reads the matching Secret File; never commit a real value.
SENSITIVE_DATA_KEY="<local-32-byte-key-as-canonical-base64>"
# Production only: direct regular file under /etc/secrets, never an environment key value.
SENSITIVE_DATA_KEY_FILE="/etc/secrets/sensitive_data_key"

# Real seeded accounts used only by the explicit local contract verification command.
LOCAL_CONTRACT_PATIENT_ACCOUNT="<patient-account>"
LOCAL_CONTRACT_PATIENT_PASSWORD="<patient-password>"
LOCAL_CONTRACT_CAREGIVER_ACCOUNT="<caregiver-account>"
LOCAL_CONTRACT_CAREGIVER_PASSWORD="<caregiver-password>"
LOCAL_CONTRACT_DOCTOR_ACCOUNT="<doctor-account>"
LOCAL_CONTRACT_DOCTOR_PASSWORD="<doctor-password>"
LOCAL_CONTRACT_ADMIN_ACCOUNT="<admin-account>"
LOCAL_CONTRACT_ADMIN_PASSWORD="<admin-password>"
LOCAL_CONTRACT_AUDITOR_ACCOUNT="<auditor-account>"
LOCAL_CONTRACT_AUDITOR_PASSWORD="<auditor-password>"

# Production requires all three MiMo capabilities and doctor review. These are
# launch gates, never feature flags or fallback switches.
AI_REQUIRED_FOR_LAUNCH="true"
SPEECH_REQUIRED_FOR_LAUNCH="true"
TTS_REQUIRED_FOR_LAUNCH="true"
AI_HUMAN_REVIEW_REQUIRED="true"

# A single MiMo credential is shared by AI assessment, STT, and TTS.
# Local development only: set MIMO_API_KEY in ignored .env for real connectivity.
# Production must leave MIMO_API_KEY absent and use this Secret File instead.
MIMO_API_KEY_REF="secret-manager://<mimo-api-key-reference>"
MIMO_API_KEY="<local-mimo-api-key-not-for-production>"
MIMO_API_KEY_FILE="/etc/secrets/mimo_api_key"
MIMO_ALLOWED_HOSTS="<approved-mimo-api-host>"

AI_PROVIDER="xiaomi-mimo"
AI_MODEL_VERSION="<exact-mimo-model-version>"
AI_MODEL_ENDPOINT="https://<approved-mimo-api-host>/v1"
AI_PROMPT_VERSION="<approved-assessment-prompt-version>"
SPEECH_PROVIDER="xiaomi-mimo-audio-understanding"
SPEECH_MODEL_VERSION="mimo-v2.5-asr"
SPEECH_TO_TEXT_ENDPOINT="https://<approved-mimo-api-host>/v1/chat/completions"
TTS_PROVIDER="xiaomi-mimo-tts"
TTS_MODEL_VERSION="mimo-v2.5-tts"
TTS_ENDPOINT="https://<approved-mimo-api-host>/v1/chat/completions"
TTS_VOICE_ID="<customer-approved-voice-id>"
TTS_OUTPUT_FORMAT="wav"

# Every provider capability declares request limits. Values must fit the API
# request boundary: timeout <= 2147483647 and response bytes <= 16777216.
AI_PROVIDER_TIMEOUT_MS="<positive-safe-integer>"
AI_PROVIDER_MAX_RESPONSE_BYTES="<positive-safe-integer-up-to-16777216>"
SPEECH_PROVIDER_TIMEOUT_MS="<positive-safe-integer>"
SPEECH_PROVIDER_MAX_RESPONSE_BYTES="<positive-safe-integer-up-to-16777216>"
STT_MAX_DECODED_AUDIO_BYTES="<positive-safe-integer-up-to-11796480-bytes>"
STT_MAX_DURATION_SECONDS="<positive-safe-integer-seconds>"
TTS_PROVIDER_TIMEOUT_MS="<positive-safe-integer>"
TTS_PROVIDER_MAX_RESPONSE_BYTES="<positive-safe-integer-up-to-16777216>"

# Render Key Value is mandatory in production. Use its same-region internal
# connection string. The quota values require customer approval; no defaults exist.
MIMO_KEY_VALUE_URL="redis://<render-key-value-private-host>:6379"
MIMO_USAGE_KEY_PREFIX="<production-mimo-quota-prefix>"
MIMO_USAGE_WINDOW_MS="<positive-safe-integer-milliseconds>"
MIMO_KEY_VALUE_PROBE_TIMEOUT_MS="<positive-safe-integer-milliseconds>"
MIMO_USER_REQUEST_LIMIT="<positive-safe-integer>"
MIMO_PATIENT_REQUEST_LIMIT="<positive-safe-integer>"
MIMO_ORGANIZATION_REQUEST_LIMIT="<positive-safe-integer>"
MIMO_SPEECH_SECONDS_LIMIT="<positive-safe-integer>"
MIMO_TTS_CHARACTERS_LIMIT="<positive-safe-integer>"
MIMO_USER_BUDGET_UNITS_LIMIT="<positive-safe-integer>"
MIMO_PATIENT_BUDGET_UNITS_LIMIT="<positive-safe-integer>"
MIMO_ORGANIZATION_BUDGET_UNITS_LIMIT="<positive-safe-integer>"
MIMO_AI_COST_UNITS_PER_REQUEST="<positive-safe-integer>"
MIMO_SPEECH_COST_UNITS_PER_SECOND="<positive-safe-integer>"
MIMO_TTS_COST_UNITS_PER_CHARACTER="<positive-safe-integer>"
MIMO_HIGH_COST_USER_OPERATION_REQUEST_LIMIT="<positive-safe-integer>"
MIMO_HIGH_COST_USER_OPERATION_WINDOW_MS="<positive-safe-integer-milliseconds>"
# Customer-approved provider telemetry retention: 30--3650 full days.
PROVIDER_TELEMETRY_RETENTION_DAYS="<30-to-3650-integer-days>"
# Required bounded execution time for the telemetry-only retention job. No default exists.
PROVIDER_TELEMETRY_RETENTION_TIMEOUT_MS="<positive-safe-integer-milliseconds>"

# Dedicated local/CI Redis integration test only. The runner rejects every URL
# except this disposable database and requires the explicit YES confirmation.
MIMO_USAGE_GATE_REDIS_TEST_URL="redis://127.0.0.1:6379/15"
MIMO_USAGE_GATE_REDIS_TEST_CONFIRM_DISPOSABLE="YES"

# One-time production bootstrap only. These must be direct Render Secret Files
# under /etc/secrets and must never be added to a local .env, Git, or evidence.
# The command creates only the approved organization, admin_super, and doctor.
PRODUCTION_BOOTSTRAP_CONFIG_FILE="/etc/secrets/production_bootstrap.json"
PRODUCTION_BOOTSTRAP_ADMIN_PASSWORD_FILE="/etc/secrets/production_bootstrap_admin_password"
PRODUCTION_BOOTSTRAP_DOCTOR_PASSWORD_FILE="/etc/secrets/production_bootstrap_doctor_password"
# Manual first-admin credential reset only; it also accepts a direct Secret File.
CREDENTIAL_RESET_PASSWORD_FILE="/etc/secrets/credential_reset_password"
