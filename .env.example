# Local development example. Copy to .env and fill with your own values.
# Trial/production environments must use independently generated secrets and managed credentials.
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?schema=public"
REDIS_URL="redis://<redis_host>:<redis_port>"
JWT_SECRET="<generate-a-long-random-secret>"
WEB_ORIGIN="http://localhost:3000"
PORT="4000"
DEFAULT_PATIENT_PASSWORD="<local-initial-password>"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# Required before claiming production AI/speech integration is ready.
# Use secret references instead of raw keys when possible.
AI_PROVIDER="<ai-provider-name>"
AI_MODEL_VERSION="<ai-model-version>"
AI_MODEL_ENDPOINT="https://<ai-provider-endpoint>"
AI_API_KEY_REF="<secret-manager-reference-for-ai-key>"
AI_PROMPT_VERSION="<assessment-prompt-version>"
AI_CALL_LOG_RETENTION_DAYS="180"
AI_HUMAN_REVIEW_REQUIRED="true"
SPEECH_PROVIDER="<speech-provider-name>"
SPEECH_TO_TEXT_ENDPOINT="https://<speech-to-text-endpoint>"
SPEECH_API_KEY_REF="<secret-manager-reference-for-speech-key>"
SPEECH_MODEL_VERSION="<speech-model-version>"
